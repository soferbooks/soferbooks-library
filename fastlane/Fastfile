# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

BUNDLE_ID = "com.soferbooks.library"

platform :ios do
  desc "Build unsigned iOS device .app/.ipa and Simulator .app into build/apple/"
  lane :build_ios_archive do
    sh("cd .. && npm install") unless ENV["CI"]
    profile = ENV["IOS_PROVISIONING_PROFILE_NAME"] || "#{BUNDLE_ID} AppStore"

    if ENV["IOS_SIGNED"] == "1"
      build_app(
        scheme:           "ReaderApp",
        workspace:        "./ios/ReaderApp.xcworkspace",
        output_directory: "./build/apple",
        output_name:      "SoferBooks-Library-iOS",
        export_method:    "app-store",
        disable_xcpretty: true,
        xcargs:           "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER='#{profile}'",
        export_options:   {
          method:               "app-store",
          signingStyle:         "manual",
          provisioningProfiles: {
            BUNDLE_ID => profile
          }
        }
      )
    else
      sh(
        "cd .. && xcodebuild " \
        "-workspace ios/ReaderApp.xcworkspace " \
        "-scheme ReaderApp " \
        "-configuration Release " \
        "-sdk iphoneos " \
        "-derivedDataPath build/ios-device " \
        "CODE_SIGN_IDENTITY='' CODE_SIGNING_REQUIRED=NO CODE_SIGNING_ALLOWED=NO DEVELOPMENT_TEAM='' " \
        "build"
      )
    end
  end

  desc "Build Apple Silicon Mac app wrapper / DMG (Designed for iPad) into build/apple/"
  lane :build_mac do
    build_ios_archive unless File.directory?("../build/ios-device/Build/Products/Release-iphoneos/ReaderApp.app")
    sh(<<~BASH)
      set -euo pipefail
      cd ..
      mkdir -p build/apple build/mac-stage/Payload
      rm -rf "build/mac-stage/SoferBooks Library.app" "build/apple/SoferBooks-Library-macOS-AppleSilicon.dmg" "build/apple/SoferBooks-Library-macOS.app.zip"
      mkdir -p "build/mac-stage/SoferBooks Library.app/Wrapper"
      cp -R build/ios-device/Build/Products/Release-iphoneos/ReaderApp.app "build/mac-stage/SoferBooks Library.app/Wrapper/ReaderApp.app"
      ln -s Wrapper/ReaderApp.app "build/mac-stage/SoferBooks Library.app/WrappedBundle"
      ditto -c -k --sequesterRsrc --keepParent "build/mac-stage/SoferBooks Library.app" build/apple/SoferBooks-Library-macOS.app.zip
      hdiutil create -volname "SoferBooks Library" -srcfolder "build/mac-stage/SoferBooks Library.app" -ov -format UDZO build/apple/SoferBooks-Library-macOS-AppleSilicon.dmg
    BASH
  end

  desc "Build and upload to TestFlight.
        Called by both deploy-ios.yml (QA, version from build.gradle) and
        deploy-ios-release.yml (prod, version_name provided or from build.gradle).
        version_name: required MAJOR.MINOR.PATCH"
  lane :beta do |options|
    api_key = app_store_connect_api_key(
      key_id:       ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:    ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_filepath: "/tmp/AuthKey.p8",
    )

    version_name = options[:version_name]
    if version_name && !version_name.empty?
      UI.user_error!("version_name must be MAJOR.MINOR.PATCH") \
        unless version_name.match?(/\A\d+\.\d+\.\d+\z/)
      increment_version_number(
        version_number: version_name,
        xcodeproj: "./ios/ReaderApp.xcodeproj"
      )
    end

    # Unix timestamp as build number — same pattern as Android QA builds.
    # Always unique and increasing; never committed; no branch conflicts.
    increment_build_number(
      build_number: Time.now.to_i.to_s,
      xcodeproj: "./ios/ReaderApp.xcodeproj"
    )

    # GITHUB_REF_NAME is set in CI; git fallback is empty on detached HEAD.
    branch = (ENV["GITHUB_REF_NAME"] || sh("git branch --show-current").strip).strip

    sh("cd .. && npm install") unless ENV["CI"]

    profile = ENV["IOS_PROVISIONING_PROFILE_NAME"] || "#{BUNDLE_ID} AppStore"
    team = ENV["FASTLANE_TEAM_ID"] || ""
    team_arg = team.empty? ? "" : " DEVELOPMENT_TEAM='#{team}'"

    build_app(
      scheme:           "ReaderApp",
      workspace:        "./ios/ReaderApp.xcworkspace",
      export_method:    "app-store",
      disable_xcpretty: true,
      xcargs:           "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER='#{profile}'#{team_arg}",
      export_options:   {
        method:               "app-store",
        signingStyle:         "manual",
        provisioningProfiles: {
          BUNDLE_ID => profile
        }
      }
    )

    # changelog populates TestFlight's "What to Test", mirroring the Android
    # lane's "Branch: <branch>" note. Only set it for QA builds (story branches
    # carry the sc-NNNNN id); skip on master/main. Attaches only after build
    # processing, which upload_to_testflight waits for by default.
    testflight_options = { api_key: api_key }
    unless branch.empty? || branch == "master" || branch == "main"
      testflight_options[:changelog] = "Branch: #{branch}"
    end
    upload_to_testflight(testflight_options)
  end

  # App Review's notes and its real-iPhone recording (metadata/review_information, review/app-in-use.mp4:
  # Mordy, 2026-11-22), and, with SUBMIT=true, the newest TestFlight build sent for review. Only those: the
  # store listing and its screenshots, set on the website, are left as they are.
  desc "App Review's notes and recording; with SUBMIT=true the newest build sent for review"
  lane :review do
    api_key = app_store_connect_api_key(
      key_id:       ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:    ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_filepath: "/tmp/AuthKey.p8",
    )
    # (the version the TestFlight builds carry: deploy-ios.yml gives `beta` the one in android/app/build.gradle -
    #  the Xcode project's MARKETING_VERSION is Sefaria's and is not what was uploaded)
    gradle = File.read("../android/app/build.gradle")
    version = %w[MAJOR MINOR PATCH].map { |k| gradle[/^def VERSION_#{k}=\s*(\d+)/, 1] }.join(".")
    UI.user_error!("no version in android/app/build.gradle") unless version.match?(/\A\d+\.\d+\.\d+\z/)
    # (ONLY_SUBMIT: the notes and recording uploaded by an earlier run are left to finish processing - each upload
    #  replaces the attachment, and Apple answers "Version is not ready to be submitted yet" while it is processed)
    unless ENV["ONLY_SUBMIT"] == "true"
    deliver(
      api_key:                    api_key,
      app_identifier:             BUNDLE_ID,
      platform:                   "ios",
      app_version:                version,
      skip_binary_upload:         true,
      skip_screenshots:           true,
      metadata_path:              "./fastlane/metadata",
      app_review_attachment_file: (File.exist?("review/app-in-use.mp4") ? "./fastlane/review/app-in-use.mp4" : nil),
      submit_for_review:          false,   # (sent below: Apple keeps one open submission per app)
      automatic_release:          false,
      force:                      true,
      run_precheck_before_submit: false,
      submission_information: {
        add_id_info_uses_idfa:                       false,
        export_compliance_uses_encryption:           false,
        content_rights_contains_third_party_content: true,
        content_rights_has_rights:                   true,
      },
    )
    end
    submit_open_submission if ENV["SUBMIT"] == "true" || ENV["ONLY_SUBMIT"] == "true"
  end

  # Apple keeps one open review submission per app (2026-11-22: deliver refused with "A review submission is
  # already in progress"): deliver only makes a new one. This sends the open one - after a rejection, its
  # "unresolved issues" (Apple's last message printed first) - with the version deliver just updated, or makes one.
  # One that is already with Apple (waiting for review, in review) is left as it is.
  private_lane :submit_open_submission do
    states = Spaceship::ConnectAPI::ReviewSubmission::ReviewSubmissionState
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.user_error!("no App Store version to submit") unless version
    UI.message("Version #{version.version_string}: #{version.app_store_state}")
    # (the newest processed build of this version: deliver picks it only when it submits itself)
    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, version: version.version_string, processing_states: "VALID",
                                             platform: Spaceship::ConnectAPI::Platform::IOS).first
    UI.user_error!("no processed build of #{version.version_string}") unless build
    version.select_build(build_id: build.id)
    UI.message("Build #{build.version} chosen for #{version.version_string}")
    open = app.get_review_submissions(filter: {
      platform: Spaceship::ConnectAPI::Platform::IOS,
      state: [states::READY_FOR_REVIEW, states::UNRESOLVED_ISSUES, states::WAITING_FOR_REVIEW, states::IN_REVIEW].join(","),
    })
    open.each { |sub| UI.message("Open review submission #{sub.id}: #{sub.state}") }
    with_apple = open.find { |sub| [states::WAITING_FOR_REVIEW, states::IN_REVIEW].include?(sub.state) }
    if with_apple
      UI.important("Already with Apple (#{with_apple.state}): nothing more sent")
      next
    end
    sub = open.find { |o| o.state == states::UNRESOLVED_ISSUES } ||
          open.find { |o| o.state == states::READY_FOR_REVIEW } ||
          app.create_review_submission(platform: Spaceship::ConnectAPI::Platform::IOS)
    # (after a rejection the submission's item stays REJECTED, and Apple answers "Version is not ready to be
    #  submitted yet" until it is marked resolved - what the website's "Resubmit to App Review" does)
    require "net/http"
    require "json"
    asc = lambda do |verb, path, body = nil|
      u = URI("https://api.appstoreconnect.apple.com#{path}")
      req = (verb == :get ? Net::HTTP::Get : Net::HTTP::Patch).new(u, "Content-Type" => "application/json",
                                                            "Authorization" => "Bearer #{Spaceship::ConnectAPI.token.text}")
      req.body = body.to_json if body
      Net::HTTP.start(u.host, u.port, use_ssl: true) { |h| h.request(req) }
    end
    items = JSON.parse(asc.call(:get, "/v1/reviewSubmissions/#{sub.id}/items").body)["data"] || []
    items.select { |it| it.dig("attributes", "state") == "REJECTED" }.each do |it|
      r = asc.call(:patch, "/v1/reviewSubmissionItems/#{it["id"]}",
                   { data: { type: "reviewSubmissionItems", id: it["id"], attributes: { resolved: true } } })
      UI.message("Rejected item marked resolved: #{r.code}#{r.is_a?(Net::HTTPSuccess) ? "" : " " + r.body}")
    end
    if sub.state == states::UNRESOLVED_ISSUES
      begin
        sub.latest_resolution_center_messages.each do |m|
          UI.important("Apple (#{m.created_date}): #{m.message_body.to_s.gsub(/<[^>]+>/, ' ').squeeze(' ')}")
        end
      rescue StandardError => e
        UI.message("Apple's messages could not be read: #{e.message}")
      end
    end
    begin
      sub.add_app_store_version_to_review_items(app_store_version_id: version.id)
    rescue StandardError => e
      UI.message("Version #{version.version_string} is in the submission already (#{e.message.lines.first&.strip})")
    end
    # (sent here, not by sub.submit_for_review: fastlane's error drops Apple's list of what blocks it - "associatedErrors")
    res = asc.call(:patch, "/v1/reviewSubmissions/#{sub.id}", { data: { type: "reviewSubmissions", id: sub.id, attributes: { submitted: true } } })
    unless res.is_a?(Net::HTTPSuccess)
      UI.error("Apple refused the submission (#{res.code}):")
      puts(JSON.pretty_generate(JSON.parse(res.body))) rescue puts(res.body)
      UI.user_error!("not submitted: see Apple's answer above")
    end
    UI.success("Submitted for review: version #{version.version_string}")
  end
end
