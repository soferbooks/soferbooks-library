# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

BUNDLE_ID = "com.soferbooks.library"

platform :ios do
  desc "Build unsigned iOS device .app/.ipa and Simulator .app into build/apple/"
  lane :build_ios_archive do
    sh("cd .. && npm install") unless ENV["CI"]
    profile = ENV["IOS_PROVISIONING_PROFILE_NAME"] || "#{BUNDLE_ID} AppStore"

    if ENV["IOS_SIGNED"] == "1"
      build_app(
        scheme:           "ReaderApp",
        workspace:        "./ios/ReaderApp.xcworkspace",
        output_directory: "./build/apple",
        output_name:      "SoferBooks-Library-iOS",
        export_method:    "app-store",
        disable_xcpretty: true,
        xcargs:           "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER='#{profile}'",
        export_options:   {
          method:               "app-store",
          signingStyle:         "manual",
          provisioningProfiles: {
            BUNDLE_ID => profile
          }
        }
      )
    else
      sh(
        "cd .. && xcodebuild " \
        "-workspace ios/ReaderApp.xcworkspace " \
        "-scheme ReaderApp " \
        "-configuration Release " \
        "-sdk iphoneos " \
        "-derivedDataPath build/ios-device " \
        "CODE_SIGN_IDENTITY='' CODE_SIGNING_REQUIRED=NO CODE_SIGNING_ALLOWED=NO DEVELOPMENT_TEAM='' " \
        "build"
      )
    end
  end

  desc "Build Apple Silicon Mac app wrapper / DMG (Designed for iPad) into build/apple/"
  lane :build_mac do
    build_ios_archive unless File.directory?("../build/ios-device/Build/Products/Release-iphoneos/ReaderApp.app")
    sh(<<~BASH)
      set -euo pipefail
      cd ..
      mkdir -p build/apple build/mac-stage/Payload
      rm -rf "build/mac-stage/SoferBooks Library.app" "build/apple/SoferBooks-Library-macOS-AppleSilicon.dmg" "build/apple/SoferBooks-Library-macOS.app.zip"
      mkdir -p "build/mac-stage/SoferBooks Library.app/Wrapper"
      cp -R build/ios-device/Build/Products/Release-iphoneos/ReaderApp.app "build/mac-stage/SoferBooks Library.app/Wrapper/ReaderApp.app"
      ln -s Wrapper/ReaderApp.app "build/mac-stage/SoferBooks Library.app/WrappedBundle"
      ditto -c -k --sequesterRsrc --keepParent "build/mac-stage/SoferBooks Library.app" build/apple/SoferBooks-Library-macOS.app.zip
      hdiutil create -volname "SoferBooks Library" -srcfolder "build/mac-stage/SoferBooks Library.app" -ov -format UDZO build/apple/SoferBooks-Library-macOS-AppleSilicon.dmg
    BASH
  end

  desc "Build and upload to TestFlight.
        Called by both deploy-ios.yml (QA, version from build.gradle) and
        deploy-ios-release.yml (prod, version_name provided or from build.gradle).
        version_name: required MAJOR.MINOR.PATCH"
  lane :beta do |options|
    api_key = app_store_connect_api_key(
      key_id:       ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:    ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_filepath: "/tmp/AuthKey.p8",
    )

    version_name = options[:version_name]
    if version_name && !version_name.empty?
      UI.user_error!("version_name must be MAJOR.MINOR.PATCH") \
        unless version_name.match?(/\A\d+\.\d+\.\d+\z/)
      increment_version_number(
        version_number: version_name,
        xcodeproj: "./ios/ReaderApp.xcodeproj"
      )
    end

    # Unix timestamp as build number — same pattern as Android QA builds.
    # Always unique and increasing; never committed; no branch conflicts.
    increment_build_number(
      build_number: Time.now.to_i.to_s,
      xcodeproj: "./ios/ReaderApp.xcodeproj"
    )

    # GITHUB_REF_NAME is set in CI; git fallback is empty on detached HEAD.
    branch = (ENV["GITHUB_REF_NAME"] || sh("git branch --show-current").strip).strip

    sh("cd .. && npm install") unless ENV["CI"]

    profile = ENV["IOS_PROVISIONING_PROFILE_NAME"] || "#{BUNDLE_ID} AppStore"
    team = ENV["FASTLANE_TEAM_ID"] || ""
    team_arg = team.empty? ? "" : " DEVELOPMENT_TEAM='#{team}'"

    build_app(
      scheme:           "ReaderApp",
      workspace:        "./ios/ReaderApp.xcworkspace",
      export_method:    "app-store",
      disable_xcpretty: true,
      xcargs:           "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER='#{profile}'#{team_arg}",
      export_options:   {
        method:               "app-store",
        signingStyle:         "manual",
        provisioningProfiles: {
          BUNDLE_ID => profile
        }
      }
    )

    # changelog populates TestFlight's "What to Test", mirroring the Android
    # lane's "Branch: <branch>" note. Only set it for QA builds (story branches
    # carry the sc-NNNNN id); skip on master/main. Attaches only after build
    # processing, which upload_to_testflight waits for by default.
    testflight_options = { api_key: api_key }
    unless branch.empty? || branch == "master" || branch == "main"
      testflight_options[:changelog] = "Branch: #{branch}"
    end
    upload_to_testflight(testflight_options)
  end

  # App Review's notes and its real-iPhone recording (metadata/review_information, review/app-in-use.mp4:
  # Mordy, 2026-11-22), and, with SUBMIT=true, the newest TestFlight build sent for review. Only those: the
  # store listing and its screenshots, set on the website, are left as they are.
  desc "App Review's notes and recording; with SUBMIT=true the newest build sent for review"
  lane :review do
    api_key = app_store_connect_api_key(
      key_id:       ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:    ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_filepath: "/tmp/AuthKey.p8",
    )
    version = get_version_number(xcodeproj: "./ios/ReaderApp.xcodeproj", target: "ReaderApp")
    deliver(
      api_key:                    api_key,
      app_identifier:             BUNDLE_ID,
      platform:                   "ios",
      app_version:                version,
      skip_binary_upload:         true,
      skip_screenshots:           true,
      metadata_path:              "./fastlane/metadata",
      app_review_attachment_file: (File.exist?("review/app-in-use.mp4") ? "./fastlane/review/app-in-use.mp4" : nil),
      submit_for_review:          ENV["SUBMIT"] == "true",
      automatic_release:          false,
      force:                      true,
      run_precheck_before_submit: false,
      submission_information: {
        add_id_info_uses_idfa:                       false,
        export_compliance_uses_encryption:           false,
        content_rights_contains_third_party_content: true,
        content_rights_has_rights:                   true,
      },
    )
  end
end
