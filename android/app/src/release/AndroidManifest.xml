<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    >

    <!-- These are added by React Native for debug mode, but actually aren't needed in releasemode -->
    <uses-permission tools:node="remove" android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Local Soferia download server for testing (http://127.0.0.1:5200 via adb reverse).
         Remove this when the library is served over HTTPS. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
