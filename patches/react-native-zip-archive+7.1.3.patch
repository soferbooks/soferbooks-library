+  private static void collectZipItems(File dir, String prefix, List<File> filesOut, List<String> namesOut) {
+    File[] children = dir.listFiles();
+    if (children == null) { return; }
+    for (File child : children) {
+      String entryName = prefix + child.getName();
+      if (child.isDirectory()) {
+        collectZipItems(child, entryName + "/", filesOut, namesOut);
+      } else {
+        filesOut.add(child);
+        namesOut.add(entryName);
+      }
+    }
