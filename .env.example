# Baked in at build time by react-native-config; .env itself is gitignored.
GOOGLE_SSO_CLIENT_ID=your-google-oauth-client-id-here
GOOGLE_SSO_IOS_CLIENT_ID=your-ios-oauth-client-id-here
# Optional, developers only: download the library from a local export server
# (tools/server/serve.py) instead of Sefaria's. USB device: `adb reverse tcp:5200 tcp:5200`;
# Android emulator: http://10.0.2.2:5200. Leave unset for Sefaria's own server.
# SEFARIA_DOWNLOAD_SERVER=http://127.0.0.1:5200
